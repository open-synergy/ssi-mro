<odoo>
<data noupdate="1">
<record id="mro_order_internal_user_rule" model="ir.rule">
    <field name="name">mro_order - Internal User</field>
    <field name="model_id" ref="model_mro_order" />
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
    <field name="domain_force">[('user_id','=',user.id)]</field>
</record>

<record id="mro_order_company_rule" model="ir.rule">
    <field name="name">mro_order - Responsible to company data</field>
    <field name="model_id" ref="model_mro_order" />
    <field name="groups" eval="[(4, ref('mro_order_company_group'))]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
    <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
</record>

<record id="mro_order_child_company_rule" model="ir.rule">
    <field
                name="name"
            >mro_order - Responsible to company and all child companies data</field>
    <field name="model_id" ref="model_mro_order" />
    <field name="groups" eval="[(4, ref('mro_order_child_company_group'))]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
    <field name="domain_force">[('company_id','in',user.company_ids.ids)]</field>
</record>

<record id="mro_order_all_rule" model="ir.rule">
    <field name="name">mro_order - Responsible to all data</field>
    <field name="model_id" ref="model_mro_order" />
    <field name="groups" eval="[(4, ref('mro_order_all_group'))]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
    <field name="domain_force">[(1,'=',1)]</field>
</record>
</data>
</odoo>
