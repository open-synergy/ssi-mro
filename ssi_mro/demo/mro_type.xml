            <field name="name">Predictive Maintenance</field>
            <field name="code">PREDICTIVE</field>
            <field name="active" eval="1" />
        </record>

        <record id="mro_type_breakdown" model="mro_type">
            <field name="name">Breakdown Maintenance</field>
            <field name="code">BREAKDOWN</field>
            <field name="active" eval="1" />
        </record>
    </data>
