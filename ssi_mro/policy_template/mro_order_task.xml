<odoo>
<record id="policy_template_mro_order_task" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_mro_order_task" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','mro_order_task'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- Confirm -->
<record id="policy_template_mro_order_task_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_mro_order_task" />
    <field
            name="field_id"
            search="[('model_id.model','=','mro_order_task'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','mro_order_task'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('mro_order_task_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Open -->
<record id="policy_template_mro_order_task_open" model="policy.template_detail">
    <field name="template_id" ref="policy_template_mro_order_task" />
    <field
            name="field_id"
            search="[('model_id.model','=','mro_order_task'),('name','=','open_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','mro_order_task'),('value','=','ready')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('mro_order_task_user_group')])]" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if document.order_id and document.order_id.state == 'open':
    result = True</field>
</record>



<!-- Reject -->
<record id="policy_template_mro_order_task_reject" model="policy.template_detail">
    <field name="template_id" ref="policy_template_mro_order_task" />
    <field
            name="field_id"
            search="[('model_id.model','=','mro_order_task'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','mro_order_task'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Approve -->
<record id="policy_template_mro_order_task_approve" model="policy.template_detail">
    <field name="template_id" ref="policy_template_mro_order_task" />
    <field
            name="field_id"
            search="[('model_id.model','=','mro_order_task'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','mro_order_task'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Done -->
<record id="policy_template_mro_order_task_done" model="policy.template_detail">
    <field name="template_id" ref="policy_template_mro_order_task" />
    <field
            name="field_id"
            search="[('model_id.model','=','mro_order_task'),('name','=','done_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','mro_order_task'),('value','=','open')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('mro_order_task_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Cancel -->
<record id="policy_template_mro_order_task_cancel" model="policy.template_detail">
    <field name="template_id" ref="policy_template_mro_order_task" />
    <field
            name="field_id"
            search="[('model_id.model','=','mro_order_task'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','mro_order_task'),('value','in',['draft','open','terminate'])]"
        />
            <field name="restrict_user" eval="1" />
            <field name="computation_method">use_group</field>
            <field
            name="group_ids"
            eval="[(6,0,[ref('mro_order_task_validator_group')])]"
        />
            <field name="restrict_additional" eval="0" />
</record>

