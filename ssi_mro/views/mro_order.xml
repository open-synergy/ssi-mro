<odoo>
<record id="mro_order_view_search" model="ir.ui.view">
    <field name="name">mro_order - search</field>
    <field name="model">mro_order</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="mro_order_view_tree" model="ir.ui.view">
    <field name="name">mro_order - tree</field>
    <field name="model">mro_order</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="type_id" />
                <field name="customer_id" optional="hide" />
                <field name="vendor_id" optional="hide" />
                <field name="num_of_tasks" />
                <field name="num_of_open_tasks" />
                <field name="num_of_done_tasks" />
                <field name="num_of_canceled_tasks" />
                <field name="num_of_terminated_tasks" />
            </xpath>
        </data>
    </field>
</record>

<record id="mro_order_view_form" model="ir.ui.view">
    <field name="name">mro_order - form</field>
    <field name="model">mro_order</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="type_id" />
                <field
                        name="allowed_product_category_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                <field
                        name="allowed_product_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                <field name="customer_id" />
                <field name="vendor_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="task" string="Tasks">
                    <group name="task_1" colspan="4" col="2">
                        <group name="task_1_1" colspan="1" col="2">
                            <field name="num_of_tasks" />
                            <field name="num_of_open_tasks" />
                        </group>
                        <group name="task_1_2" colspan="1" col="2">
                            <field name="num_of_done_tasks" />
                            <field name="num_of_canceled_tasks" />
                            <field name="num_of_terminated_tasks" />
                        </group>
                    </group>
                    <button
                            name="action_load_task"
                            string="Load Tasks"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            attrs="{'invisible':[('state','!=','draft')]}"
                        />
                    <field
                            name="allowed_mro_task_ids"
                            widget="many2many_tags"
                            invisible="1"
                        />
                    <field
                            name="task_ids"
                            nolabel="1"
                            context="{'default_order_id': active_id}"
                            widget="many2many"
                            domain="[('id','in',allowed_mro_task_ids)]"
                        />
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="mro_order_action" model="ir.actions.act_window">
    <field name="name">MRO Orders</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">mro_order</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="mro_order_menu"
        name="MRO Orders"
        action="mro_order_action"
        groups="mro_order_viewer_group"
        parent="stock.menu_stock_warehouse_mgmt"
    />
</odoo>
