<odoo>
<record id="mro_order_task_view_search" model="ir.ui.view">
    <field name="name">mro_order_task - search</field>
    <field name="model">mro_order_task</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="mro_order_task_view_tree" model="ir.ui.view">
    <field name="name">mro_order_task - tree</field>
    <field name="model">mro_order_task</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="product_id" />
                <field name="lot_id" />
                <field name="action_id" />
                <field name="order_id" />
                <field name="earliest_date" />
                <field name="latest_date" />
                <field name="actual_finish_date" />
            </xpath>
        </data>
    </field>
</record>

<record id="mro_order_task_view_form" model="ir.ui.view">
    <field name="name">mro_order_task - form</field>
    <field name="model">mro_order_task</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="action_id" />
                <field
                        name="allowed_product_category_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                <field
                        name="allowed_product_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                <field
                        name="product_id"
                        domain="[('tracking', '=', 'serial'),'|',('id','in', allowed_product_ids),('categ_id','in', allowed_product_category_ids)]"
                    />
                <field name="lot_id" domain="[('product_id', '=', product_id)]" />
                <field name="current_location_id" force_save="1" readonly="1" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="earliest_date" />
                <field name="latest_date" />
                <field name="actual_finish_date" />
                <field name="order_id" />
            </xpath>
            <xpath expr="//page[1]" position="before">
            </xpath>
        </data>
    </field>
</record>

<record id="mro_order_task_action" model="ir.actions.act_window">
    <field name="name">MRO Tasks</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">mro_order_task</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="mro_order_task_menu"
        name="MRO Tasks"
        action="mro_order_task_action"
        groups="mro_order_task_viewer_group"
        parent="stock.menu_stock_warehouse_mgmt"
    />
</odoo>
