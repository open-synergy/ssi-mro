<odoo>
<record id="mro_type_view_search" model="ir.ui.view">
    <field name="name">mro_type - search</field>
    <field name="model">mro_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
        </data>
    </field>
</record>

<record id="mro_type_view_tree" model="ir.ui.view">
    <field name="name">mro_type - tree</field>
    <field name="model">mro_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
            </xpath>
        </data>
    </field>
</record>

<record id="mro_type_view_form" model="ir.ui.view">
    <field name="name">mro_type - form</field>
    <field name="model">mro_type</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="product" string="Product Settings">
                    <group
                            name="product_category_1"
                            col="2"
                            colspan="4"
                            string="Product Category"
                        >
                        <field
                                name="product_category_selection_method"
                                string="Selection Method"
                            />
                        <field
                                name="product_category_ids"
                                attrs="{'invisible':[('product_category_selection_method','!=','manual')]}"
                            />
                        <field
                                name="product_category_domain"
                                widget="domain"
                                options="{'model': 'product.category', 'in_dialog': True}"
                                attrs="{'invisible':[('product_category_selection_method','!=','domain')]}"
                                string="Domain"
                            />
                        <field
                                name="product_category_python_code"
                                widget="ace"
                                attrs="{'invisible':[('product_category_selection_method','!=','code')]}"
                                string="Python Code"
                            />
                    </group>
                    <group name="product_1" col="2" colspan="4" string="Product">
                        <field
                                name="product_selection_method"
                                string="Selection Method"
                            />
                        <field
                                name="product_ids"
                                attrs="{'invisible':[('product_selection_method','!=','manual')]}"
                            />
                        <field
                                name="product_domain"
                                widget="domain"
                                options="{'model': 'product.product', 'in_dialog': True}"
                                attrs="{'invisible':[('product_selection_method','!=','domain')]}"
                                string="Domain"
                            />
                        <field
                                name="product_python_code"
                                widget="ace"
                                attrs="{'invisible':[('product_selection_method','!=','code')]}"
                                string="Python Code"
                            />
                    </group>
                </page>
                <page name="action" string="Action Settings">
                    <group name="action_1" col="2" colspan="4" string="Action">
                        <field
                                name="action_selection_method"
                                string="Selection Method"
                            />
                        <field
                                name="action_ids"
                                attrs="{'invisible':[('action_selection_method','!=','manual')]}"
                            />
                        <field
                                name="action_domain"
                                widget="domain"
                                options="{'model': 'mro.action', 'in_dialog': True}"
                                attrs="{'invisible':[('action_selection_method','!=','domain')]}"
                                string="Domain"
                            />
                        <field
                                name="action_python_code"
                                widget="ace"
                                attrs="{'invisible':[('action_selection_method','!=','code')]}"
                                string="Python Code"
                            />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="mro_type_action" model="ir.actions.act_window">
    <field name="name">MRO Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">mro_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="mro_type_menu"
        name="MRO Types"
        action="mro_type_action"
        groups="mro_type_configurator_group"
        parent="menu_mro_config"
    />
</odoo>
