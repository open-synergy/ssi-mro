<odoo>
<record id="mro_action_view_search" model="ir.ui.view">
    <field name="name">mro_action - search</field>
    <field name="model">mro_action</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <filter
                        name="dom_kind_maintenance"
                        string="Maintenance"
                        domain="[('kind','=','maintenance')]"
                    />
                <filter
                        name="dom_kind_repair"
                        string="Repair"
                        domain="[('kind','=','repair')]"
                    />
                <filter
                        name="dom_kind_overhaul"
                        string="Overhaul"
                        domain="[('kind','=','overhaul')]"
                    />
                <group name="group_by">
                    <filter
                            name="grp_kind"
                            string="Kind"
                            context="{'group_by':'kind'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="mro_action_view_tree" model="ir.ui.view">
    <field name="name">mro_action - tree</field>
    <field name="model">mro_action</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
            </xpath>
        </data>
    </field>
</record>

<record id="mro_action_view_form" model="ir.ui.view">
    <field name="name">mro_action - form</field>
    <field name="model">mro_action</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="kind" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="product" string="Product Settings">
                    <group
                            name="product_category_1"
                            col="2"
                            colspan="4"
                            string="Product Category"
                        >
                        <field
                                name="product_category_selection_method"
                                string="Selection Method"
                            />
                        <field
                                name="product_category_ids"
                                attrs="{'invisible':[('product_category_selection_method','!=','manual')]}"
                            />
                        <field
                                name="product_category_domain"
                                widget="domain"
                                options="{'model': 'product.category', 'in_dialog': True}"
                                attrs="{'invisible':[('product_category_selection_method','!=','domain')]}"
                                string="Domain"
                            />
                        <field
                                name="product_category_python_code"
                                widget="ace"
                                attrs="{'invisible':[('product_category_selection_method','!=','code')]}"
                                string="Python Code"
                            />
                    </group>
                    <group name="product_1" col="2" colspan="4" string="Product">
                        <field
                                name="product_selection_method"
                                string="Selection Method"
                            />
                        <field
                                name="product_ids"
                                attrs="{'invisible':[('product_selection_method','!=','manual')]}"
                            />
                        <field
                                name="product_domain"
                                widget="domain"
                                options="{'model': 'product.product', 'in_dialog': True}"
                                attrs="{'invisible':[('product_selection_method','!=','domain')]}"
                                string="Domain"
                            />
                        <field
                                name="product_python_code"
                                widget="ace"
                                attrs="{'invisible':[('product_selection_method','!=','code')]}"
                                string="Python Code"
                            />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="mro_action_action" model="ir.actions.act_window">
    <field name="name">MRO Actions</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">mro_action</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="mro_action_menu"
        name="MRO Actions"
        action="mro_action_action"
        groups="mro_action_configurator_group"
        parent="menu_mro_config"
    />
</odoo>
